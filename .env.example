# Copy this file to .env. The app loads .env automatically when it starts.
# No API key is needed for Ollama after you install it and download the model.
HINDSIGHT_LLM_PROVIDER=ollama
HINDSIGHT_LLM_API_KEY=
HINDSIGHT_LLM_URL=http://localhost:11434/v1/chat/completions
HINDSIGHT_LLM_MODEL=llama3.2

# To use a hosted OpenAI-compatible service instead, set:
# HINDSIGHT_LLM_PROVIDER=openai-compatible
# HINDSIGHT_LLM_API_KEY=your-provider-key
# HINDSIGHT_LLM_URL=https://api.openai.com/v1/chat/completions
# HINDSIGHT_LLM_MODEL=gpt-4o-mini

# Optional indicators/enrichment. Use JSON values; no external lookup is done.
HONEYTOKEN_ACCOUNTS=
HINDSIGHT_GEOIP_MAP_JSON={}
HINDSIGHT_THREAT_FEED_JSON=[]

# Optional webhooks/email. Never commit populated credentials.
HINDSIGHT_WEBHOOK_KIND=generic
HINDSIGHT_WEBHOOK_URL=
